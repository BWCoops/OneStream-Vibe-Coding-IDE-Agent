# ── OneStream ──
ONESTREAM_DEFAULT_API_VERSION=7.2.0
ONESTREAM_PAT_VAULT_PATH=secret/onestream/environments

# ── AI Provider ──
ANTHROPIC_API_KEY=sk-ant-...
VLLM_ENDPOINT=http://localhost:8000
LLM_PROVIDER=anthropic          # 'anthropic' (cloud) or 'vllm' (on-prem)
LLM_MODEL=claude-sonnet-4-20250514

# ── Database ──
POSTGRES_PASSWORD=localdev
DATABASE_URL=postgresql://ide_agent:localdev@localhost:5432/onestream_ide
PGVECTOR_ENABLED=true

# ── Neo4j ──
NEO4J_PASSWORD=localdev
NEO4J_URI=bolt://localhost:7687

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── RabbitMQ ──
RABBITMQ_PASSWORD=localdev
RABBITMQ_URL=amqp://ide_agent:localdev@localhost:5672

# ── EventStoreDB ──
EVENTSTOREDB_URL=esdb://localhost:2113?tls=false

# ── Observability ──
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_SECRET=localdev-secret

# ── Security ──
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=localdev-token
OPA_ENDPOINT=http://localhost:8181
JWT_SECRET=change-me-in-production
